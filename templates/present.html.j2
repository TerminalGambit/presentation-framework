<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>{{ meta.title | default("Presentation") }}</title>
<link href="https://fonts.googleapis.com/css2?family={{ theme.fonts.subheading | default('Montserrat') | replace(' ', '+') }}:wght@300;400;500;600&display=swap" rel="stylesheet"/>
<style>
  :root {
    --navy: {{ theme.primary | default('#1C2537') }};
    --gold: {{ theme.accent | default('#C4A962') }};
    --gold-dim: rgba(196, 169, 98, 0.4);
    --gold-glow: rgba(196, 169, 98, 0.15);
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    background: #000;
    overflow: hidden;
    height: 100vh; width: 100vw;
    font-family: '{{ theme.fonts.subheading | default("Montserrat") }}', system-ui, sans-serif;
    cursor: none;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  body.show-ui { cursor: default; }
  #slide-frame {
    width: 1280px; height: 720px;
    border: none;
    transform-origin: center center;
    transition: opacity 0.25s ease, transform 0.25s ease;
    flex-shrink: 0;
  }
  #slide-frame.fading { opacity: 0; }
  /* Wipe transition classes — forward: exit left, enter from right;
     backward: exit right, enter from left */
  #slide-frame.exiting       { opacity: 0; transform: translateX(-40px) scale(0.98); }
  #slide-frame.exiting-right { opacity: 0; transform: translateX(40px) scale(0.98); }
  #slide-frame.entering      { opacity: 0; transform: translateX(40px) scale(0.98); }
  #slide-frame.entering-back { opacity: 0; transform: translateX(-40px) scale(0.98); }
  .progress-bar {
    position: fixed; bottom: 0; left: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--gold), #d4b96e);
    transition: width 0.4s ease;
    z-index: 200;
    box-shadow: 0 0 8px var(--gold-glow);
  }
  .controls {
    position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%);
    display: flex; gap: 12px; align-items: center;
    z-index: 100;
    background: rgba(28, 37, 55, 0.95);
    padding: 10px 28px; border-radius: 30px;
    border: 1px solid rgba(196, 169, 98, 0.25);
    backdrop-filter: blur(10px);
    opacity: 0; transition: opacity 0.3s ease; pointer-events: none;
  }
  body.show-ui .controls { opacity: 1; pointer-events: all; }
  .controls button {
    background: none; border: 1px solid var(--gold-dim); color: var(--gold);
    padding: 7px 18px; border-radius: 20px; cursor: pointer;
    font-size: 13px; font-family: '{{ theme.fonts.subheading | default("Montserrat") }}', system-ui;
    font-weight: 500; letter-spacing: 0.5px; transition: all 0.2s;
  }
  .controls button:hover { background: var(--gold-glow); border-color: var(--gold); }
  .controls button.active { background: var(--gold); color: var(--navy); border-color: var(--gold); }
  .counter { color: #888; font-size: 13px; min-width: 60px; text-align: center; font-weight: 400; }
  .counter .current { color: var(--gold); font-weight: 600; }
  .hints {
    position: fixed; top: 20px; right: 24px; color: #444; font-size: 11px;
    z-index: 100; text-align: right; line-height: 1.8;
    opacity: 0; transition: opacity 0.3s ease; pointer-events: none;
  }
  body.show-ui .hints { opacity: 1; }
  .hints kbd {
    background: rgba(196, 169, 98, 0.1); border: 1px solid rgba(196, 169, 98, 0.2);
    border-radius: 3px; padding: 1px 6px;
    font-family: '{{ theme.fonts.subheading | default("Montserrat") }}', monospace;
    font-size: 10px; color: #888;
  }
  .slide-number {
    position: fixed; top: 20px; left: 24px; color: #333; font-size: 11px;
    z-index: 100; font-weight: 300; letter-spacing: 1px;
    opacity: 0; transition: opacity 0.3s ease;
  }
  body.show-ui .slide-number { opacity: 1; }
  .grid-overlay {
    position: fixed; top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0, 0, 0, 0.92); z-index: 300;
    display: none; padding: 40px; overflow-y: auto;
  }
  .grid-overlay.visible { display: block; }
  .grid-overlay h2 {
    color: var(--gold); font-family: '{{ theme.fonts.subheading | default("Montserrat") }}', sans-serif;
    font-weight: 300; font-size: 18px; letter-spacing: 3px;
    text-transform: uppercase; margin-bottom: 30px; text-align: center;
  }
  .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; max-width: 1200px; margin: 0 auto; }
  .thumb {
    position: relative; aspect-ratio: 16/9;
    border: 2px solid transparent; border-radius: 6px;
    overflow: hidden; cursor: pointer; transition: all 0.2s;
  }
  .thumb:hover { border-color: var(--gold); transform: scale(1.03); }
  .thumb.active { border-color: var(--gold); box-shadow: 0 0 20px var(--gold-glow); }
  .thumb iframe { width: 1280px; height: 720px; transform-origin: top left; pointer-events: none; border: none; }
  .thumb-label {
    position: absolute; bottom: 0; left: 0; right: 0;
    background: linear-gradient(transparent, rgba(0,0,0,0.8));
    color: #ccc; padding: 20px 10px 8px; font-size: 11px; font-weight: 500;
  }
  .thumb-label .num { color: var(--gold); margin-right: 4px; }
  .click-zone { position: fixed; top: 0; height: 100%; z-index: 50; cursor: pointer; }
  .click-zone.left { left: 0; width: 15%; }
  .click-zone.right { right: 0; width: 15%; }
  .notes-panel {
    position: fixed; right: 0; top: 0; bottom: 0; width: 320px;
    background: rgba(20, 28, 40, 0.97); border-left: 1px solid var(--gold-dim);
    z-index: 250; display: none; flex-direction: column;
    font-family: '{{ theme.fonts.subheading | default("Montserrat") }}', system-ui; backdrop-filter: blur(10px);
  }
  .notes-panel.visible { display: flex; }
  .notes-panel-header {
    padding: 16px 20px; border-bottom: 1px solid var(--gold-dim);
    color: var(--gold); font-size: 12px; font-weight: 600; letter-spacing: 2px;
    display: flex; justify-content: space-between; align-items: center;
  }
  .notes-panel-body {
    padding: 20px; flex: 1; overflow-y: auto; color: #ccc; font-size: 14px; line-height: 1.6;
    white-space: pre-line;
  }
  /* ── Lightbox ───────────────────────────────── */
  .lightbox-overlay {
    position: fixed; top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0, 0, 0, 0.95); z-index: 400;
    display: none; justify-content: center; align-items: center;
    backdrop-filter: blur(5px);
  }
  .lightbox-overlay.active { display: flex; }
  .lightbox-container {
    position: relative; max-width: 90vw; max-height: 90vh;
    display: flex; flex-direction: column; align-items: center;
  }
  .lightbox-image {
    max-width: 100%; max-height: calc(90vh - 60px);
    object-fit: contain; border-radius: 8px;
    box-shadow: 0 0 30px var(--gold-glow);
  }
  .lightbox-caption {
    color: var(--gold); margin-top: 16px; font-size: 14px; text-align: center;
  }
  .lightbox-close {
    position: absolute; top: -40px; right: 0;
    background: none; border: none; color: var(--gold);
    font-size: 32px; cursor: pointer; transition: transform 0.2s;
  }
  .lightbox-close:hover { transform: scale(1.2); }
  /* ── Chart Modal ──────────────────────────── */
  .chart-modal-overlay {
    position: fixed; top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0, 0, 0, 0.95); z-index: 400;
    display: none; justify-content: center; align-items: center;
    backdrop-filter: blur(5px);
  }
  .chart-modal-overlay.active { display: flex; }
  .chart-modal-container {
    width: 90vw; height: 80vh;
    position: relative;
  }
  .chart-modal-close {
    position: absolute; top: -40px; right: 0;
    background: none; border: none; color: var(--gold);
    font-size: 32px; cursor: pointer; transition: transform 0.2s;
    z-index: 410;
  }
  .chart-modal-close:hover { transform: scale(1.2); }

  /* ── Presenter Mode ─────────────────────────── */
  body.presenter-mode {
    display: block;
    overflow: hidden;
    cursor: default;
    background: #0d1117;
  }
  body.presenter-mode .controls,
  body.presenter-mode .hints,
  body.presenter-mode .slide-number,
  body.presenter-mode .click-zone,
  body.presenter-mode .notes-panel,
  body.presenter-mode .grid-overlay,
  body.presenter-mode #slide-frame,
  body.presenter-mode .progress-bar { display: none !important; }

  .presenter-layout {
    display: none;
    height: 100vh;
    grid-template-rows: 50% 1fr auto;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    font-family: '{{ theme.fonts.subheading | default("Montserrat") }}', system-ui, sans-serif;
  }
  body.presenter-mode .presenter-layout { display: grid; }

  .presenter-slide {
    position: relative;
    background: #000;
    overflow: hidden;
    border-bottom: 1px solid #222;
  }
  .presenter-slide iframe {
    width: 1280px;
    height: 720px;
    border: none;
    transform-origin: top left;
    pointer-events: none;
  }
  .presenter-slide-label {
    position: absolute;
    top: 8px;
    left: 12px;
    color: var(--gold);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    z-index: 10;
    background: rgba(0, 0, 0, 0.7);
    padding: 4px 10px;
    border-radius: 4px;
  }
  .presenter-slide.current-slide {
    border-right: 1px solid #222;
  }
  .presenter-slide.current-slide iframe {
    border: 2px solid var(--gold);
    border-radius: 4px;
  }
  .presenter-slide.next-slide iframe {
    border: 1px solid #333;
    border-radius: 4px;
    opacity: 0.75;
  }

  .presenter-notes {
    grid-column: 1 / -1;
    background: rgba(20, 28, 40, 0.97);
    border-top: 1px solid var(--gold-dim);
    min-height: 0;
    overflow-y: auto;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .presenter-notes-header {
    padding: 10px 20px;
    color: var(--gold);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2px;
    border-bottom: 1px solid rgba(196, 169, 98, 0.15);
    flex-shrink: 0;
  }
  .presenter-notes-body {
    padding: 16px 20px;
    color: #ccc;
    font-size: 15px;
    line-height: 1.7;
    flex: 1;
    overflow-y: auto;
    white-space: pre-line;
  }
  .presenter-notes-body .no-notes {
    color: #555;
    font-style: italic;
  }

  .presenter-controls {
    grid-column: 1 / -1;
    height: 48px;
    background: #0d1117;
    border-top: 1px solid #222;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 24px;
    color: #888;
    font-size: 13px;
  }
  .presenter-controls-nav {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .presenter-controls-nav button {
    background: none;
    border: 1px solid #333;
    color: var(--gold);
    padding: 4px 14px;
    border-radius: 14px;
    cursor: pointer;
    font-size: 12px;
    font-family: inherit;
    transition: all 0.2s;
  }
  .presenter-controls-nav button:hover {
    background: var(--gold-glow);
    border-color: var(--gold);
  }
  .presenter-controls-counter .current {
    color: var(--gold);
    font-weight: 600;
  }
  .presenter-controls-timer {
    color: var(--gold);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
    user-select: none;
    padding: 4px 10px;
    border-radius: 4px;
    transition: background 0.2s;
  }
  .presenter-controls-timer:hover { background: rgba(196, 169, 98, 0.1); }
  .presenter-controls-timer.countdown { color: #6bc5e8; }
  .presenter-controls-timer.expired {
    color: #e85d5d;
    animation: timer-pulse 1s ease-in-out infinite;
  }
  @keyframes timer-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }
  .presenter-controls-keys {
    color: #555;
    font-size: 11px;
  }
  .presenter-controls-keys kbd {
    background: rgba(196, 169, 98, 0.08);
    border: 1px solid rgba(196, 169, 98, 0.15);
    border-radius: 3px;
    padding: 1px 5px;
    font-family: inherit;
    font-size: 10px;
    color: #666;
  }
</style>
{% if theme.charts %}
<script src="https://cdn.plot.ly/plotly-2.35.2.min.js" charset="utf-8"></script>
{% endif %}
</head>
<body class="show-ui">

<iframe id="slide-frame" src="{{ slides[0] }}"></iframe>
<div class="progress-bar" id="progress"></div>
<div class="slide-number" id="slideNum">SLIDE 01</div>

<div class="controls" id="controls">
  <button onclick="prev()" title="Previous slide">&#8592; PREV</button>
  <span class="counter"><span class="current" id="cur">1</span> / <span id="tot">{{ total }}</span></span>
  <button onclick="next()" title="Next slide">NEXT &#8594;</button>
  <button onclick="toggleGrid()" title="Slide overview">&#9638; GRID</button>
  <button onclick="toggleFS()" title="Fullscreen">&#9974; FULL</button>
</div>

<div class="hints" id="hints">
  <kbd>&#8592;</kbd> <kbd>&#8594;</kbd> navigate<br/>
  <kbd>&#8595;</kbd> reveal / <kbd>&#8593;</kbd> hide<br/>
  <kbd>F</kbd> fullscreen<br/>
  <kbd>G</kbd> grid overview<br/>
  <kbd>N</kbd> speaker notes<br/>
  <kbd>H</kbd> hide UI<br/>
  <kbd>1</kbd>-<kbd>9</kbd> jump to slide<br/>
  <kbd>P</kbd> presenter view
</div>

<div class="click-zone left" onclick="prev()"></div>
<div class="click-zone right" onclick="next()"></div>

<div class="notes-panel" id="notesPanel">
  <div class="notes-panel-header">
    <span>SPEAKER NOTES</span>
    <button onclick="toggleNotes()" style="background:none;border:none;color:var(--gold);cursor:pointer;font-size:18px;">&times;</button>
  </div>
  <div class="notes-panel-body" id="notesPanelBody">
    <p style="color:#666;font-style:italic;">No notes for this slide.</p>
  </div>
</div>

<!-- Lightbox -->
<div class="lightbox-overlay" id="lightboxOverlay" onclick="if(event.target===this)closeLightbox()">
  <button class="lightbox-close" onclick="closeLightbox()">&times;</button>
  <div class="lightbox-container">
    <img id="lightboxImage" class="lightbox-image" src="" alt=""/>
    <div class="lightbox-caption" id="lightboxCaption"></div>
  </div>
</div>

<!-- Chart Modal -->
<div class="chart-modal-overlay" id="chartModalOverlay" onclick="if(event.target===this)closeChartModal()">
  <button class="chart-modal-close" onclick="closeChartModal()">&times;</button>
  <div class="chart-modal-container" id="chartModalContainer"></div>
</div>

<div class="grid-overlay" id="gridOverlay">
  <h2>Slide Overview</h2>
  <div class="grid" id="gridContainer"></div>
</div>

<!-- ── Presenter Mode Layout ─────────────────── -->
<div class="presenter-layout" id="presenterLayout">
  <div class="presenter-slide current-slide" id="presenterCurrent">
    <div class="presenter-slide-label">CURRENT</div>
    <iframe id="presenterCurrentFrame"></iframe>
  </div>
  <div class="presenter-slide next-slide" id="presenterNext">
    <div class="presenter-slide-label">NEXT</div>
    <iframe id="presenterNextFrame"></iframe>
  </div>
  <div class="presenter-notes">
    <div class="presenter-notes-header">SPEAKER NOTES</div>
    <div class="presenter-notes-body" id="presenterNotesBody">
      <span class="no-notes">No notes for this slide.</span>
    </div>
  </div>
  <div class="presenter-controls">
    <div class="presenter-controls-nav">
      <button onclick="prev()">&#8592;</button>
      <span class="presenter-controls-counter"><span class="current" id="presCur">1</span> / {{ total }}</span>
      <button onclick="next()">&#8594;</button>
    </div>
    <div class="presenter-controls-timer" id="presenterTimer" onclick="toggleTimerMode()" title="Click to toggle elapsed/countdown. Shift+T to reset.">&#9201; 00:00</div>
    <div class="presenter-controls-keys">
      <kbd>&#8592;</kbd><kbd>&#8594;</kbd> nav
      <kbd>&#8595;</kbd><kbd>&#8593;</kbd> fragments
      <kbd>F</kbd> full
      <kbd>G</kbd> grid
      <kbd>T</kbd> timer
      <kbd>H</kbd> hide
    </div>
  </div>
</div>

<script>
const SLIDES = {{ slides_json }};
const TOTAL = SLIDES.length;
const TITLES = {{ titles_json }};
const TRANSITIONS = {{ transitions_json }};
const NOTES = {{ notes_json }};
const TRANSITION_STYLE = "{{ transition_style | default('fade') }}";

let current = 1;
let prevSlide = 1;
let uiVisible = true;
let uiTimeout;
let notesVisible = false;
let lightboxActive = false;

// ── BroadcastChannel sync ──────────────────────────────
const IS_PRESENTER = location.hash === '#presenter';
let _bcReceiving = false;
let _bc = null;
try { _bc = new BroadcastChannel('pf-presenter'); } catch(e) {}

function bcSend(msg) {
  if (_bcReceiving || !_bc) return;
  _bc.postMessage(msg);
}

if (_bc) {
  _bc.onmessage = function(e) {
    var msg = e.data;
    if (!msg || !msg.type) return;
    _bcReceiving = true;
    try {
      switch (msg.type) {
        case 'navigate':
          show(msg.slide, false, msg.showAllFragments);
          break;
        case 'fragment':
          if (msg.action === 'reveal') revealNextFragment();
          else if (msg.action === 'hide') hideLastFragment();
          else if (msg.action === 'reveal-all') revealAllFragments();
          break;
        case 'sync-request':
          bcSend({ type: 'sync-response', slide: current });
          break;
        case 'sync-response':
          show(msg.slide, true); // instant=true: skip transition on initial sync
          break;
      }
    } finally { _bcReceiving = false; }
  };
}

// ── Presenter mode ─────────────────────────────
var presenterCurrentFrame, presenterNextFrame, presenterNotesBody, presCurEl, presenterTimer;

function initPresenter() {
  document.body.classList.add('presenter-mode');
  document.title = 'Presenter — ' + document.title;

  presenterCurrentFrame = document.getElementById('presenterCurrentFrame');
  presenterNextFrame = document.getElementById('presenterNextFrame');
  presenterNotesBody = document.getElementById('presenterNotesBody');
  presCurEl = document.getElementById('presCur');
  presenterTimer = document.getElementById('presenterTimer');

  resizePresenterFrames();
  window.addEventListener('resize', resizePresenterFrames);
}

function resizePresenterFrames() {
  var slides = document.querySelectorAll('.presenter-slide');
  slides.forEach(function(container) {
    var iframe = container.querySelector('iframe');
    if (!iframe) return;
    var w = container.clientWidth;
    var h = container.clientHeight;
    var scale = Math.min(w / 1280, h / 720);
    iframe.style.transform = 'scale(' + scale + ')';
  });
}

// ── Timer ──────────────────────────────────────
// timerStarted was forward-declared in Task 3 — now we replace the placeholder
var timerStarted = false;
var timerInterval = null;
var timerElapsed = 0;       // seconds elapsed
var timerMode = 'elapsed';  // 'elapsed' or 'countdown'
var countdownTotal = 0;     // seconds for countdown
var countdownRemaining = 0;

function startTimer() {
  if (timerStarted || !IS_PRESENTER) return;
  timerStarted = true;
  timerElapsed = 0;
  timerInterval = setInterval(function() {
    timerElapsed++;
    updateTimerDisplay();
  }, 1000);
}

function updateTimerDisplay() {
  if (!presenterTimer) return;
  var display, seconds;
  if (timerMode === 'elapsed') {
    seconds = timerElapsed;
    display = '\u23F1 ' + formatTime(seconds);
    presenterTimer.className = 'presenter-controls-timer';
  } else {
    countdownRemaining = Math.max(0, countdownTotal - timerElapsed);
    seconds = countdownRemaining;
    display = '\u23F3 ' + formatTime(seconds);
    if (countdownRemaining <= 0) {
      presenterTimer.className = 'presenter-controls-timer countdown expired';
    } else {
      presenterTimer.className = 'presenter-controls-timer countdown';
    }
  }
  presenterTimer.textContent = display;
}

function formatTime(totalSeconds) {
  var m = Math.floor(totalSeconds / 60);
  var s = totalSeconds % 60;
  return String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
}

function toggleTimerMode() {
  if (!IS_PRESENTER) return;
  if (timerMode === 'elapsed') {
    var minutes = prompt('Countdown duration in minutes:', '30');
    if (minutes === null) return;
    var parsed = parseInt(minutes, 10);
    if (isNaN(parsed) || parsed <= 0) return;
    timerMode = 'countdown';
    countdownTotal = parsed * 60;
    countdownRemaining = Math.max(0, countdownTotal - timerElapsed);
  } else {
    timerMode = 'elapsed';
  }
  updateTimerDisplay();
}

function resetTimer() {
  timerElapsed = 0;
  if (timerMode === 'countdown') {
    countdownRemaining = countdownTotal;
  }
  updateTimerDisplay();
}

var _origShow = show;
function presenterShow(n, instant, showAllFragments) {
  var prevN = current;
  current = Math.max(1, Math.min(TOTAL, n));
  var file = SLIDES[current - 1];
  var nextFile = current < TOTAL ? SLIDES[current] : null;

  // Update presenter iframes
  presenterCurrentFrame.src = file;
  if (nextFile) {
    presenterNextFrame.src = nextFile;
    presenterNextFrame.style.visibility = 'visible';
  } else {
    presenterNextFrame.src = 'about:blank';
    presenterNextFrame.style.visibility = 'hidden';
  }

  // Update counter
  presCurEl.textContent = current;

  // Update notes
  var note = NOTES[current - 1];
  presenterNotesBody.innerHTML = note
    ? '<p>' + note.replace(/</g, '&lt;').replace(/>/g, '&gt;') + '</p>'
    : '<span class="no-notes">No notes for this slide.</span>';

  // Broadcast
  bcSend({ type: 'navigate', slide: current, showAllFragments: !!showAllFragments });

  // Start timer on first navigation
  if (!timerStarted) startTimer();

  prevSlide = current;
}

if (IS_PRESENTER) {
  // Override fragment functions to target presenter's current iframe
  revealNextFragment = function() {
    var revealed = false;
    try {
      var hidden = Array.from(presenterCurrentFrame.contentDocument.querySelectorAll('.pf-fragment:not(.visible)'));
      if (hidden.length > 0) { hidden[0].classList.add('visible'); revealed = true; }
    } catch(e) {
      try { presenterCurrentFrame.contentWindow.postMessage({ __pf: 'reveal-fragment' }, '*'); } catch(e2) {}
    }
    if (revealed) bcSend({ type: 'fragment', action: 'reveal' });
    return revealed;
  };

  hideLastFragment = function() {
    var hidden = false;
    try {
      var vis = Array.from(presenterCurrentFrame.contentDocument.querySelectorAll('.pf-fragment.visible'));
      if (vis.length > 0) { vis[vis.length - 1].classList.remove('visible'); hidden = true; }
    } catch(e) {
      try { presenterCurrentFrame.contentWindow.postMessage({ __pf: 'hide-fragment' }, '*'); } catch(e2) {}
    }
    if (hidden) bcSend({ type: 'fragment', action: 'hide' });
    return hidden;
  };

  revealAllFragments = function() {
    try {
      Array.from(presenterCurrentFrame.contentDocument.querySelectorAll('.pf-fragment')).forEach(function(f) { f.classList.add('visible'); });
    } catch(e) {
      try { presenterCurrentFrame.contentWindow.postMessage({ __pf: 'reveal-all' }, '*'); } catch(e2) {}
    }
  };
}

const frame = document.getElementById('slide-frame');
const progress = document.getElementById('progress');
const curEl = document.getElementById('cur');
const slideNumEl = document.getElementById('slideNum');
const gridOverlay = document.getElementById('gridOverlay');
const notesPanel = document.getElementById('notesPanel');
const notesPanelBody = document.getElementById('notesPanelBody');

function resize() {
  const vw = window.innerWidth, vh = window.innerHeight;
  const scale = Math.min(vw / 1280, vh / 720);
  frame.style.transform = 'scale(' + scale + ')';
}
window.addEventListener('resize', resize);
document.addEventListener('fullscreenchange', () => { requestAnimationFrame(resize); setTimeout(resize, 100); });
resize();

// ── Fragment state machine ──────────────────────────────
// Uses postMessage as primary channel (works on file:// with local restrictions).
// Falls back to direct contentDocument access when served over HTTP.
function _pfMsg(type) {
  try { frame.contentWindow.postMessage({ __pf: type }, '*'); } catch(e) {}
}

function revealNextFragment() {
  var revealed = false;
  try {
    var hidden = Array.from(frame.contentDocument.querySelectorAll('.pf-fragment:not(.visible)'));
    if (hidden.length > 0) { hidden[0].classList.add('visible'); revealed = true; }
  } catch(e) { _pfMsg('reveal-fragment'); }
  if (revealed) bcSend({ type: 'fragment', action: 'reveal' });
  return revealed;
}

function hideLastFragment() {
  var hidden = false;
  try {
    var vis = Array.from(frame.contentDocument.querySelectorAll('.pf-fragment.visible'));
    if (vis.length > 0) { vis[vis.length - 1].classList.remove('visible'); hidden = true; }
  } catch(e) { _pfMsg('hide-fragment'); }
  if (hidden) bcSend({ type: 'fragment', action: 'hide' });
  return hidden;
}

function revealAllFragments() {
  try {
    Array.from(frame.contentDocument.querySelectorAll('.pf-fragment')).forEach(function(f) { f.classList.add('visible'); });
  } catch(e) { _pfMsg('reveal-all'); }
  bcSend({ type: 'fragment', action: 'reveal-all' });
}

function show(n, instant, showAllFragments) {
  const prev = current;
  current = Math.max(1, Math.min(TOTAL, n));
  const file = SLIDES[current - 1];
  const isForward = current >= prev;

  curEl.textContent = current;
  slideNumEl.textContent = 'SLIDE ' + String(current).padStart(2, '0');
  progress.style.width = ((current / TOTAL) * 100) + '%';
  document.querySelectorAll('.thumb').forEach((t, i) => { t.classList.toggle('active', i === current - 1); });
  if (notesVisible) loadNotes();

  if (instant || TRANSITION_STYLE === 'none') {
    frame.src = file;
    frame.addEventListener('load', function onLoad() {
      frame.removeEventListener('load', onLoad);
      if (showAllFragments) revealAllFragments();
      enableLightbox();
      enableChartModals();
    }, { once: true });
  } else if (TRANSITION_STYLE === 'wipe') {
    const exitClass = isForward ? 'exiting' : 'exiting-right';
    const enterClass = isForward ? 'entering' : 'entering-back';
    frame.classList.add(exitClass);
    setTimeout(() => {
      frame.src = file;
      frame.classList.remove(exitClass);
      frame.classList.add(enterClass);
      frame.addEventListener('load', function onLoad() {
        frame.removeEventListener('load', onLoad);
        // Double rAF: ensures entering state is painted before the transition fires
        requestAnimationFrame(() => requestAnimationFrame(() => {
          frame.classList.remove(enterClass);
          if (showAllFragments) revealAllFragments();
          enableLightbox();
          enableChartModals();
        }));
      }, { once: true });
    }, 220);
  } else {
    // fade (default)
    frame.classList.add('fading');
    setTimeout(() => {
      frame.src = file;
      frame.classList.remove('fading');
      frame.addEventListener('load', function onLoad() {
        frame.removeEventListener('load', onLoad);
        if (showAllFragments) revealAllFragments();
        enableLightbox();
        enableChartModals();
      }, { once: true });
    }, 200);
  }

  prevSlide = current;
  bcSend({ type: 'navigate', slide: current, showAllFragments: !!showAllFragments });
}
function next() {
  show(current + 1);
}
function prev() {
  show(current - 1, false, true); // showAllFragments=true on backward nav
}

function toggleNotes() {
  notesVisible = !notesVisible;
  notesPanel.classList.toggle('visible', notesVisible);
  if (notesVisible) loadNotes();
}

function loadNotes() {
  const note = NOTES[current - 1];
  notesPanelBody.innerHTML = note
    ? '<p>' + note.replace(/</g, '&lt;').replace(/>/g, '&gt;') + '</p>'
    : '<p style="color:#666;font-style:italic;">No notes for this slide.</p>';
}
function toggleFS() { if (!document.fullscreenElement) document.documentElement.requestFullscreen(); else document.exitFullscreen(); }
function toggleGrid() { gridOverlay.classList.toggle('visible'); if (gridOverlay.classList.contains('visible')) buildGrid(); }
function toggleUI() { uiVisible = !uiVisible; document.body.classList.toggle('show-ui', uiVisible); }

function buildGrid() {
  const container = document.getElementById('gridContainer');
  if (container.children.length > 0) { document.querySelectorAll('.thumb').forEach((t, i) => { t.classList.toggle('active', i === current - 1); }); return; }
  for (let i = 1; i <= TOTAL; i++) {
    const thumb = document.createElement('div');
    thumb.className = 'thumb' + (i === current ? ' active' : '');
    const inner = document.createElement('iframe');
    inner.src = SLIDES[i - 1]; inner.loading = 'lazy';
    const containerWidth = (1200 - 48) / 4;
    const scale = containerWidth / 1280;
    inner.style.transform = 'scale(' + scale + ')';
    thumb.style.height = (720 * scale) + 'px';
    const label = document.createElement('div');
    label.className = 'thumb-label';
    label.innerHTML = '<span class="num">' + i + '.</span> ' + TITLES[i-1];
    thumb.appendChild(inner); thumb.appendChild(label);
    thumb.addEventListener('click', () => { show(i); gridOverlay.classList.remove('visible'); });
    container.appendChild(thumb);
  }
}

function resetUITimer() {
  document.body.classList.add('show-ui'); uiVisible = true;
  clearTimeout(uiTimeout);
  uiTimeout = setTimeout(() => { if (!gridOverlay.classList.contains('visible')) { document.body.classList.remove('show-ui'); uiVisible = false; } }, 3000);
}
document.addEventListener('mousemove', resetUITimer);
document.addEventListener('click', resetUITimer);

function openLightbox(src, alt) {
  document.getElementById('lightboxImage').src = src;
  document.getElementById('lightboxCaption').textContent = alt || '';
  document.getElementById('lightboxOverlay').classList.add('active');
  lightboxActive = true;
}
function closeLightbox() {
  document.getElementById('lightboxOverlay').classList.remove('active');
  lightboxActive = false;
}
function enableLightbox() {
  try {
    const imgs = frame.contentDocument.querySelectorAll('img');
    imgs.forEach(img => {
      if (img.dataset.lightbox) return;
      img.dataset.lightbox = '1';
      img.style.cursor = 'zoom-in';
      img.addEventListener('click', e => {
        e.stopPropagation();
        openLightbox(img.src, img.alt);
      });
    });
  } catch(e) { /* cross-origin — lightbox unavailable */ }
}
let chartModalActive = false;

function openChartModal(chartConfig, chartType) {
  var container = document.getElementById('chartModalContainer');
  container.innerHTML = '';
  document.getElementById('chartModalOverlay').classList.add('active');
  chartModalActive = true;
  try {
    var iframeWindow = frame.contentWindow;
    if (iframeWindow && iframeWindow.initChart) {
      iframeWindow.initChart(container, chartConfig, chartType);
    }
  } catch(e) { console.warn('Chart modal render failed', e); }
}

function closeChartModal() {
  document.getElementById('chartModalOverlay').classList.remove('active');
  document.getElementById('chartModalContainer').innerHTML = '';
  chartModalActive = false;
}

function enableChartModals() {
  try {
    var charts = frame.contentDocument.querySelectorAll('.chart-container, .chart-inline');
    charts.forEach(function(chart) {
      if (chart.dataset.modalBound) return;
      chart.dataset.modalBound = '1';
      chart.style.cursor = 'zoom-in';
      chart.addEventListener('click', function(e) {
        e.stopPropagation();
        var config = JSON.parse(chart.dataset.chartConfig);
        var chartType = chart.dataset.chartType;
        openChartModal(config, chartType);
      });
    });
  } catch(e) { /* cross-origin */ }
}
document.addEventListener('keydown', e => {
  if (chartModalActive) { if (e.key === 'Escape') { e.preventDefault(); closeChartModal(); } return; }
  if (lightboxActive) { if (e.key === 'Escape') { e.preventDefault(); closeLightbox(); } return; }
  if (gridOverlay.classList.contains('visible')) { if (e.key === 'Escape' || e.key === 'g' || e.key === 'G') { e.preventDefault(); gridOverlay.classList.remove('visible'); } return; }
  switch(e.key) {
    case 'ArrowRight': case ' ': case 'PageDown': e.preventDefault(); next(); break;
    case 'ArrowDown': e.preventDefault(); revealNextFragment(); break;
    case 'ArrowUp': e.preventDefault(); hideLastFragment(); break;
    case 'ArrowLeft': case 'PageUp': e.preventDefault(); prev(); break;
    case 'Home': e.preventDefault(); show(1); break;
    case 'End': e.preventDefault(); show(TOTAL); break;
    case 'f': case 'F': toggleFS(); break;
    case 'g': case 'G': toggleGrid(); break;
    case 'n': case 'N': toggleNotes(); break;
    case 'h': case 'H': toggleUI(); break;
    case 'p': case 'P':
      if (!IS_PRESENTER) window.open(location.href.split('#')[0] + '#presenter', 'pf-presenter');
      break;
    case 't':
      if (IS_PRESENTER && !e.shiftKey) toggleTimerMode();
      break;
    case 'T':
      if (IS_PRESENTER && e.shiftKey) resetTimer();
      else if (IS_PRESENTER) toggleTimerMode();
      break;
    case 'Escape': if (document.fullscreenElement) document.exitFullscreen(); break;
    default: const num = parseInt(e.key); if (num >= 1 && num <= 9) show(num); if (e.key === '0') show(10);
  }
});

if (IS_PRESENTER) {
  initPresenter();
  show = presenterShow;
  show(1, true);
} else {
  show(1, true);
}
resetUITimer();

// Request current slide from any existing window
if (_bc) bcSend({ type: 'sync-request' });

// Live-reload via SSE
if (window.location.protocol !== 'file:') {
  const evtSource = new EventSource('/__reload');
  evtSource.onmessage = function() { location.reload(); };
}
</script>
</body>
</html>
